<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>YrrpAnalyser.App</RootNamespace>
    <AssemblyName>YrrpAnalyser</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="YrrpAnalyser.AppTests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\YrrpAnalyser.Core\YrrpAnalyser.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The cnc ladder's YR cameo sprite sheet; see CameoAtlas.Data.cs for where the offsets come from. -->
    <EmbeddedResource Include="Resources\yr-cameo.png" LogicalName="YrrpAnalyser.App.Resources.yr-cameo.png" />
  </ItemGroup>
</Project>
